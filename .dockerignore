# The image's build context: only what deploy/Dockerfile copies. Everything else (data/source's
# 12 GB, node_modules, builds) stays out.
**
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.base.json
!apps/server/package.json
!apps/server/src/**
!apps/web/**
apps/web/node_modules
apps/web/dist
!packages/shared/**
packages/shared/node_modules
!data/derived/**
