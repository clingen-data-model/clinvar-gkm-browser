{
  "name": "clinvar-gkm-browser",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.13.0",
  "engines": {
    "node": ">=26.10.0 <27"
  },
  "scripts": {
    "dev": "pnpm --filter @cvb/server --filter @cvb/web --parallel dev",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck",
    "lint": "eslint --flag unstable_native_nodejs_ts_config .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build": "pnpm --filter @cvb/web build",
    "preview": "pnpm build && pnpm --filter @cvb/server preview",
    "e2e": "pnpm --filter @cvb/e2e test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4",
    "eslint-plugin-react-hooks": "7.1.1"
  }
}
