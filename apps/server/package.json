{
  "name": "@cvb/server",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/main.ts",
    "dev": "CLINVAR_DATA_DIR=${CLINVAR_DATA_DIR:-../../data} node --env-file-if-exists=.env --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "preview": "CLINVAR_DATA_DIR=${CLINVAR_DATA_DIR:-../../data} PORT=${PORT:-4173} WEB_DIST_DIR=../web/dist node --env-file-if-exists=.env src/main.ts"
  },
  "dependencies": {
    "@cvb/shared": "workspace:*",
    "@duckdb/node-api": "1.5.6-r.1",
    "@fastify/static": "10.1.6",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "pino": "10.4.0",
    "rotating-file-stream": "3.2.10",
    "zod": "4.6.7"
  }
}
